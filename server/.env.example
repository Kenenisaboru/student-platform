# Server
NODE_ENV=development
PORT=5010

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/student-platform

# Auth
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
CLIENT_URL=http://localhost:5180

# Comma-separated emails that receive admin role on registration
ADMIN_EMAILS=admin@your-university.edu

# Optional extra CORS origins (comma-separated)
# ALLOWED_ORIGINS=https://www.example.com

# Email (required in production)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=your-smtp-user
EMAIL_PASS=your-smtp-password

# Cloudinary (optional — image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
